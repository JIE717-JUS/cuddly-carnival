:root{
  --bg:#0b1220;
  --panel:#0f1724;
  --accent:#00e5ff;
  --text:#e6eef6;
}

*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{
  background: linear-gradient(180deg,var(--bg), #08121a);
  color:var(--text);
  font-family: Inter, Roboto, system-ui, -apple-system, "Segoe UI", "Helvetica Neue", Arial;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:24px;
}

main{
  width:900px;
  max-width:100%;
  display:flex;
  flex-direction:column;
  gap:12px;
  align-items:center;
}

header h1{
  font-size:20px;
  margin-bottom:4px;
  text-align:center;
  color:var(--accent);
}
header p{font-size:13px;opacity:0.85;text-align:center;margin-bottom:6px}

canvas#game{
  background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(0,0,0,0.05));
  border:1px solid rgba(255,255,255,0.04);
  width:100%;
  height:520px;
  display:block;
  border-radius:6px;
  box-shadow: 0 6px 20px rgba(2,6,23,0.6);
  touch-action: none;
}

.controls{
  display:flex;
  gap:8px;
}
button{
  background:var(--panel);
  color:var(--text);
  border:1px solid rgba(255,255,255,0.03);
  padding:8px 12px;
  border-radius:6px;
  cursor:pointer;
  font-size:14px;
}
button:hover{filter:brightness(1.05)}
footer small{opacity:0.7}
